{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<your-sql-server>;Database=IdentityApi;User Id=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "https://identity.yourdomain.com",
    "Audience": "https://identity.yourdomain.com",
    "KeyAccessToken": "<REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS>",
    "KeyRefreshToken": "<REPLACE_WITH_DIFFERENT_STRONG_SECRET_MIN_32_CHARS>",
    "ExpiresAccessToken": 3,
    "ExpiresRefreshToken": 24
  },
  "AzureServiceBus": { "ConnectionString": "" },
  "App": {
    "Name": "Identity API",
    "PasswordResetUrl": "https://app.yourdomain.com/reset-password"
  },
  "Cors": { "AllowedOrigins": [] },
  "ApplicationInsights": { "ConnectionString": "" }
}
